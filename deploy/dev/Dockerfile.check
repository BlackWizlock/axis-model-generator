FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/workspace/src
WORKDIR /workspace
COPY --chown=10001:10001 source/ /workspace/
USER 10001:10001
CMD ["python", "-c", "from pathlib import Path; import unittest; suite=unittest.TestSuite(); [suite.addTests(unittest.defaultTestLoader.discover('tests',pattern=p.name)) for p in sorted(Path('tests').glob('test_*.py'))]; result=unittest.TextTestRunner(verbosity=1).run(suite); raise SystemExit(not result.wasSuccessful())"]
