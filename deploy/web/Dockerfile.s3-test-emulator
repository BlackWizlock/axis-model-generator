LABEL com.axis.model-generator.project="axis-model-generator" \
      com.axis.model-generator.worktree="${MG_BUILD_WORKTREE}" \
      com.axis.model-generator.purpose="storage-emulator-test" \
      org.opencontainers.image.revision="${MG_BUILD_REVISION}" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      com.axis.model-generator.source-sha256="45521908307306e925c98d629e1c17d78c8b72b6ee242b1bfb1409f7d8ee5841"
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
