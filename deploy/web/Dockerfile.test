# check=error=true
FROM node:26.10.0-bookworm-slim@sha256:3ffc19ea878019d9e9ae8971732ad4a03cda44f167107173174b60ed7c65bed3 AS frontend
WORKDIR /app
COPY web/package.json web/package-lock.json ./web/
RUN npm --prefix web ci
COPY web ./web
COPY scripts/build-web.mjs scripts/build-sitemap.mjs ./scripts/
RUN node scripts/build-web.mjs
# GNU LibreDWG (GPLv3+) reads DWG as a separate program: it is built from its
# pinned source and never linked into the application.
FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83 AS libredwg
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl pkg-config xz-utils && rm -rf /var/lib/apt/lists/*
ARG LIBREDWG_VERSION=0.13.4
ARG LIBREDWG_SHA256=7e153ea4dac4cbf3dc9c50b9ef7a5604e09cdd4c5520bcf8017877bbe1422cd5
RUN curl -fsSL --max-time 600 -o /tmp/libredwg.tar.xz "https://ftp.gnu.org/gnu/libredwg/libredwg-${LIBREDWG_VERSION}.tar.xz" \
 && echo "${LIBREDWG_SHA256}  /tmp/libredwg.tar.xz" | sha256sum -c - \
 && mkdir /build && tar -xJf /tmp/libredwg.tar.xz -C /build --strip-components=1
WORKDIR /build
RUN ./configure --prefix=/opt/libredwg --disable-bindings --disable-docs --disable-shared --enable-release \
 && make -j"$(nproc)" && make install-strip
RUN mkdir /samples && cp test/test-data/example_2018.dwg test/test-data/example_2000.dwg test/test-data/2018/Polyline.dwg /samples/
FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83
RUN apt-get update && apt-get install -y --no-install-recommends git openssl && rm -rf /var/lib/apt/lists/*
RUN test "$(dpkg-query -W -f='${Version}' libseccomp2)" = '2.5.4-1+deb12u1' && python -c "import ctypes; ctypes.CDLL('libseccomp.so.2')"
RUN mkdir -p /journal/api /journal/worker && chmod 700 /journal/api /journal/worker && chown 10001:10001 /journal/worker
COPY --from=libredwg /opt/libredwg/bin/dwg2dxf /usr/local/lib/libredwg/dwg2dxf
COPY --from=libredwg /build/COPYING /usr/local/lib/libredwg/COPYING
COPY --from=libredwg /samples /opt/dwg-samples
WORKDIR /app
COPY requirements-web.lock requirements-web-test.lock ./
RUN python -m pip install --root-user-action=ignore --no-cache-dir --require-hashes -r requirements-web.lock && python -m pip check && python -m pip install --root-user-action=ignore --no-cache-dir --require-hashes -r requirements-web-test.lock && python -m pip check
COPY --from=frontend /app/web/dist ./web/dist
COPY web ./web
COPY src ./src
COPY workers ./workers
COPY tests ./tests
COPY scripts ./scripts
COPY pyproject.toml .dockerignore requirements-web.in ./
COPY LICENSE NOTICE CHANGELOG.md CONTRIBUTING.md SECURITY.md ./
COPY docs/public ./docs/public
COPY public ./public
COPY deploy/dev ./deploy/dev
COPY deploy/web ./deploy/web
COPY .github/PULL_REQUEST_TEMPLATE.md ./.github/PULL_REQUEST_TEMPLATE.md
ARG MG_BUILD_WORKTREE=p0-exchange
ARG MG_BUILD_PURPOSE=auth-test
ARG MG_BUILD_REVISION=uncommitted-local
LABEL com.axis.model-generator.project="axis-model-generator" \
      com.axis.model-generator.worktree="${MG_BUILD_WORKTREE}" \
      com.axis.model-generator.purpose="${MG_BUILD_PURPOSE}" \
      org.opencontainers.image.revision="${MG_BUILD_REVISION}"
ENV PYTHONPATH=/app/src:/app/tests PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "unittest", "discover", "-s", "tests/web", "-v"]
